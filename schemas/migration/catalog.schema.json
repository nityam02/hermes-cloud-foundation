{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.example.com/schemas/migration/catalog.schema.json",
  "title": "Hermes ServiceCatalog (v1alpha1)",
  "description": "Source to target service mapping (data-contracts section 4). Match values are compared as strings, case-insensitively; ties between entries are rejected at load by the CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "entries"],
  "properties": {
    "apiVersion": {"const": "hermes/v1alpha1"},
    "kind": {"const": "ServiceCatalog"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_at", "disclaimer"],
      "properties": {"reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "disclaimer": {"type": "string", "minLength": 1}}
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "kebab": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "capability", "source", "targets"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "category": {"enum": ["compute", "container-orchestration", "serverless-container", "kubernetes", "serverless-function", "container-registry", "object-storage", "block-storage", "file-storage", "relational-database", "nosql-database", "cache", "analytics", "streaming", "messaging-queue", "messaging-pubsub", "iot", "geospatial", "time-series", "networking", "hybrid-connectivity", "load-balancing", "cdn", "dns", "identity", "secrets", "key-management", "certificates", "monitoring", "logging", "tracing", "api-gateway", "workflow", "notification", "backup", "iac", "other"]},
        "capability": {"enum": ["network", "compute", "database", "storage", "messaging", "secrets", "observability", "identity", "dns", "none"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "service", "resource_types"],
          "properties": {
            "provider": {"const": "aws"},
            "service": {"type": "string", "minLength": 1},
            "resource_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9]+::[A-Za-z0-9]+::[A-Za-z0-9]+$"}},
            "match": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": ["string", "boolean", "number"]}}
            }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gcp", "alibaba"],
          "properties": {"gcp": {"$ref": "#/$defs/target"}, "alibaba": {"$ref": "#/$defs/target"}}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "alternatives", "compatibility", "complexity", "data_migration", "workflow", "tooling", "lock_in", "hermes_support", "differences", "issues", "references"],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "alternatives": {"$ref": "#/$defs/strings"},
        "compatibility": {"enum": ["equivalent", "compatible", "partial", "re-architect", "none", "unknown"]},
        "complexity": {"enum": ["low", "medium", "high"]},
        "data_migration": {"enum": ["required", "optional", "none"]},
        "workflow": {"$ref": "#/$defs/kebab"},
        "tooling": {"$ref": "#/$defs/strings"},
        "lock_in": {"enum": ["low", "medium", "high"]},
        "hermes_support": {"enum": ["implemented", "partial", "not-implemented"], "description": "implemented = within the Hermes v1alpha1 provisioning scope"},
        "differences": {"$ref": "#/$defs/strings"},
        "issues": {"$ref": "#/$defs/strings"},
        "references": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}
      }
    }
  }
}
