{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.example.com/schemas/migration/validation.schema.json",
  "title": "Hermes ValidationChecks / ValidationReport (v1alpha1)",
  "description": "User-declared checks (checks.yaml) and the report written by hermes migrate validate. Commands are argv lists, never shell strings; http requires TLS unless allow_insecure.",
  "oneOf": [{"$ref": "#/$defs/checks"}, {"$ref": "#/$defs/report"}],
  "$defs": {
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "checks"],
      "properties": {
        "apiVersion": {"const": "hermes/v1alpha1"},
        "kind": {"const": "ValidationChecks"},
        "metadata": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["spec-coverage", "bindings", "http", "tcp", "dns", "command"]},
        "description": {"type": "string"},
        "steps": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "spec": {"type": "string"},
        "file": {"type": "string"},
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buckets": {"type": "array", "items": {"type": "string"}}, "topics": {"type": "array", "items": {"type": "string"}},
            "subscriptions": {"type": "array", "items": {"type": "string"}}, "secrets": {"type": "array", "items": {"type": "string"}},
            "services": {"type": "array", "items": {"type": "string"}}, "database": {"type": "boolean"}, "values": {"type": "array", "items": {"type": "string"}}
          }
        },
        "url": {"type": "string", "pattern": "^https?://"},
        "expect_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "body_contains": {"type": "string"},
        "allow_insecure": {"type": "boolean"},
        "ca_file": {"type": "string"},
        "address": {"type": "string"},
        "name": {"type": "string"},
        "record_type": {"enum": ["A", "AAAA", "CNAME"]},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dir": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "spec-coverage"}}}, "then": {"required": ["spec"]}},
        {"if": {"properties": {"type": {"const": "bindings"}}}, "then": {"required": ["file"]}},
        {"if": {"properties": {"type": {"const": "http"}}}, "then": {"required": ["url"], "if": {"properties": {"url": {"pattern": "^http://"}}}, "then": {"required": ["allow_insecure"], "properties": {"allow_insecure": {"const": true}}}}},
        {"if": {"properties": {"type": {"const": "tcp"}}}, "then": {"required": ["address"]}},
        {"if": {"properties": {"type": {"const": "dns"}}}, "then": {"required": ["name", "expect"]}},
        {"if": {"properties": {"type": {"const": "command"}}}, "then": {"required": ["argv"]}}
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "summary", "passed", "results"],
      "properties": {
        "apiVersion": {"const": "hermes/v1alpha1"},
        "kind": {"const": "ValidationReport"},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_id", "checks_digest", "started_at", "finished_at"],
          "properties": {"plan_id": {"type": "string"}, "checks_name": {"type": "string"}, "checks_digest": {"type": "string"}, "started_at": {"type": "string"}, "finished_at": {"type": "string"}, "generator": {"type": "string"}}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "errors"],
          "properties": {"total": {"type": "integer"}, "passed": {"type": "integer"}, "failed": {"type": "integer"}, "errors": {"type": "integer"}}
        },
        "passed": {"type": "boolean"},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "status", "started_at", "duration_ms", "message", "evidence"],
            "properties": {
              "id": {"type": "string"}, "type": {"type": "string"}, "status": {"enum": ["pass", "fail", "error"]},
              "steps": {"type": "array", "items": {"type": "string"}}, "started_at": {"type": "string"},
              "duration_ms": {"type": "integer", "minimum": 0}, "message": {"type": "string"}, "evidence": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
