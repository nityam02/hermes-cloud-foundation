{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Hermes read-only discovery role (HermesDiscoveryReadOnly): Describe/List/Get metadata only, explicit deny for secret and data reads, ExternalId required, 1-hour sessions. Generated by Hermes; do not edit.",
  "Outputs": {
    "RoleArn": {
      "Description": "Pass to hermes inventory aws --role-arn",
      "Value": {
        "Fn::GetAtt": [
          "DiscoveryRole",
          "Arn"
        ]
      }
    }
  },
  "Parameters": {
    "ExternalId": {
      "AllowedPattern": "^[\\w+=,.@:/-]+$",
      "Description": "Random value shared out-of-band with the operator; required as sts:ExternalId (prevents confused-deputy use of the role).",
      "MaxLength": 1224,
      "MinLength": 16,
      "Type": "String"
    },
    "RoleName": {
      "Default": "HermesDiscoveryReadOnly",
      "Type": "String"
    },
    "TrustedPrincipalArn": {
      "AllowedPattern": "^arn:aws[a-zA-Z-]*:iam::[0-9]{12}:(root|role/.+|user/.+)$",
      "Description": "ARN of the principal that runs hermes inventory (an IAM role or user in the operator account, or arn:aws:iam::<account>:root).",
      "Type": "String"
    }
  },
  "Resources": {
    "DiscoveryRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "TrustedPrincipalArn"
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "Hermes read-only discovery (agentless, no secret values, no data reads)",
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "HermesReadOnlyDiscovery",
                  "Effect": "Allow",
                  "Action": [
                    "acm:DescribeCertificate",
                    "acm:ListCertificates",
                    "cloudformation:DescribeStacks",
                    "cloudformation:ListResources",
                    "cloudformation:ListStackResources",
                    "cloudformation:ListStacks",
                    "cloudfront:ListDistributions",
                    "cloudwatch:DescribeAlarms",
                    "cloudwatch:GetMetricData",
                    "dynamodb:DescribeContinuousBackups",
                    "dynamodb:DescribeTable",
                    "dynamodb:ListTables",
                    "dynamodb:ListTagsOfResource",
                    "ec2:DescribeInstances",
                    "ec2:DescribeInternetGateways",
                    "ec2:DescribeNatGateways",
                    "ec2:DescribeRegions",
                    "ec2:DescribeRouteTables",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeTransitGatewayAttachments",
                    "ec2:DescribeTransitGateways",
                    "ec2:DescribeVolumes",
                    "ec2:DescribeVpcEndpoints",
                    "ec2:DescribeVpcPeeringConnections",
                    "ec2:DescribeVpcs",
                    "ec2:DescribeVpnConnections",
                    "ec2:DescribeVpnGateways",
                    "ecr:DescribeRepositories",
                    "ecr:ListTagsForResource",
                    "ecs:DescribeClusters",
                    "ecs:DescribeServices",
                    "ecs:DescribeTaskDefinition",
                    "ecs:ListClusters",
                    "ecs:ListServices",
                    "eks:DescribeCluster",
                    "eks:DescribeNodegroup",
                    "eks:ListClusters",
                    "eks:ListNodegroups",
                    "elasticache:DescribeCacheClusters",
                    "elasticache:DescribeReplicationGroups",
                    "elasticloadbalancing:DescribeListeners",
                    "elasticloadbalancing:DescribeLoadBalancers",
                    "elasticloadbalancing:DescribeTags",
                    "elasticloadbalancing:DescribeTargetGroups",
                    "elasticloadbalancing:DescribeTargetHealth",
                    "events:ListEventBuses",
                    "events:ListRules",
                    "events:ListTargetsByRule",
                    "iam:ListAttachedRolePolicies",
                    "iam:ListInstanceProfiles",
                    "iam:ListRolePolicies",
                    "iam:ListRoles",
                    "kinesis:DescribeStreamSummary",
                    "kinesis:ListStreams",
                    "kms:DescribeKey",
                    "kms:GetKeyRotationStatus",
                    "kms:ListAliases",
                    "kms:ListKeys",
                    "kms:ListResourceTags",
                    "lambda:ListEventSourceMappings",
                    "lambda:ListFunctions",
                    "lambda:ListTags",
                    "logs:DescribeLogGroups",
                    "rds:DescribeDBClusters",
                    "rds:DescribeDBInstances",
                    "rds:DescribeDBSubnetGroups",
                    "route53:GetHostedZone",
                    "route53:ListHostedZones",
                    "s3:GetBucketLocation",
                    "s3:GetBucketOwnershipControls",
                    "s3:GetBucketPolicy",
                    "s3:GetBucketPolicyStatus",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetBucketTagging",
                    "s3:GetBucketVersioning",
                    "s3:GetEncryptionConfiguration",
                    "s3:GetLifecycleConfiguration",
                    "s3:GetReplicationConfiguration",
                    "s3:ListAllMyBuckets",
                    "secretsmanager:ListSecrets",
                    "sns:GetSubscriptionAttributes",
                    "sns:GetTopicAttributes",
                    "sns:ListSubscriptions",
                    "sns:ListTagsForResource",
                    "sns:ListTopics",
                    "sqs:GetQueueAttributes",
                    "sqs:ListQueueTags",
                    "sqs:ListQueues",
                    "ssm:DescribeParameters",
                    "states:DescribeStateMachine",
                    "states:ListStateMachines"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "HermesReadOnlyApiGateway",
                  "Effect": "Allow",
                  "Action": [
                    "apigateway:GET"
                  ],
                  "Resource": [
                    "arn:aws:apigateway:*::/apis",
                    "arn:aws:apigateway:*::/apis/*"
                  ]
                },
                {
                  "Sid": "HermesDenySecretAndDataReads",
                  "Effect": "Deny",
                  "Action": [
                    "cloudformation:GetTemplate",
                    "dynamodb:BatchGetItem",
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:Scan",
                    "ec2:GetConsoleOutput",
                    "ec2:GetLaunchTemplateData",
                    "ec2:GetPasswordData",
                    "ecr:BatchGetImage",
                    "ecr:GetAuthorizationToken",
                    "ecr:GetDownloadUrlForLayer",
                    "kinesis:GetRecords",
                    "kinesis:GetShardIterator",
                    "kms:Decrypt",
                    "lambda:GetFunction",
                    "lambda:GetLayerVersion",
                    "logs:FilterLogEvents",
                    "logs:GetLogEvents",
                    "logs:StartQuery",
                    "rds:DownloadDBLogFilePortion",
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "secretsmanager:BatchGetSecretValue",
                    "secretsmanager:GetSecretValue",
                    "sqs:ReceiveMessage",
                    "ssm:GetParameter",
                    "ssm:GetParameterHistory",
                    "ssm:GetParameters",
                    "ssm:GetParametersByPath"
                  ],
                  "Resource": "*"
                }
              ]
            },
            "PolicyName": "HermesReadOnlyDiscovery"
          }
        ],
        "RoleName": {
          "Ref": "RoleName"
        },
        "Tags": [
          {
            "Key": "hermes-component",
            "Value": "discovery"
          },
          {
            "Key": "hermes-managed-by",
            "Value": "hermes"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    }
  }
}
